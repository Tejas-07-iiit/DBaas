# M-DBaaS Host-Side Provisioning API Configuration (Phase 2)
#
# Bind configuration
# When deployed on the Ubuntu host, bind strictly to the private bridge IP:
BIND_HOST=10.50.0.2
PORT=8081

# Client IP allowlist (comma-separated)
# Restricts incoming connections to the management VM (10.50.0.7) and local tests
ALLOWED_CLIENT_IPS=10.50.0.7,127.0.0.1,localhost

# Shared API authentication secret
# Generate using: openssl rand -hex 32
# MUST be set, or the service will refuse to start.
HOST_API_TOKEN=

# Libvirt settings (default paths on Ubuntu host)
LIBVIRT_VIRSH_PATH=/usr/bin/virsh
LIBVIRT_URI=qemu:///system
