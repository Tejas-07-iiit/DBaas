# Application Environment
NODE_ENV=development
PORT=3000

# Docker Compose Configuration (Internal Network)
# When running inside Docker Compose, use container service names:
DATABASE_URL=postgresql://dbaas:dbaas_secret@postgres:5432/dbaas_platform?schema=public
REDIS_HOST=redis
REDIS_PORT=6379

# Local Development Configuration (Host Mode against mapped Docker ports)
# Uncomment the following when running `npm run start:dev` directly on host machine:
# DATABASE_URL=postgresql://dbaas:dbaas_secret@localhost:5432/dbaas_platform?schema=public
# REDIS_HOST=localhost
# REDIS_PORT=6379

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=dbaas
POSTGRES_PASSWORD=dbaas_secret
POSTGRES_DB=dbaas_platform

# Firebase Admin SDK Configuration
# Replace these with your real Firebase service account credentials.
# Note: In development/lab mode, health endpoints work without these credentials.
# Protected user endpoints (/api/v1/users/me) require valid Firebase credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Infrastructure & Lifecycle Orchestration (Phase 4)
# Provider choices: mock | local | central-management
INFRASTRUCTURE_PROVIDER=mock
ENCRYPTION_KEY=dbaas-default-dev-encryption-key-32b!
MANAGEMENT_API_URL=http://192.168.122.7:8080
CENTRAL_MANAGEMENT_URL=http://192.168.122.7:8080
CENTRAL_MANAGEMENT_API_KEY=

# Razorpay Subscription Billing (Phase 5)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_MODE=test
# Set to false to disable payment requirement (allows free activation of all plans)
PAYMENT_ENABLED=true

