# Application Environment
NODE_ENV=development
PORT=3000

# Docker Compose Configuration (Internal Network)
# When running inside Docker Compose, use container service names:
DATABASE_URL=postgresql://dbaas:dbaas_secret@postgres:5432/dbaas_platform?schema=public
REDIS_HOST=redis
REDIS_PORT=6379

# Local Development Configuration (Host Mode against mapped Docker ports)
# Uncomment the following when running `npm run start:dev` directly on host machine:
# DATABASE_URL=postgresql://dbaas:dbaas_secret@localhost:5432/dbaas_platform?schema=public
# REDIS_HOST=localhost
# REDIS_PORT=6379

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=dbaas
POSTGRES_PASSWORD=dbaas_secret
POSTGRES_DB=dbaas_platform

# Firebase Admin SDK Configuration
# Replace these with your real Firebase service account credentials.
# Note: In development/lab mode, health endpoints work without these credentials.
# Protected user endpoints (/api/v1/users/me) require valid Firebase credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
