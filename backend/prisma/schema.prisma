generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  ADMIN
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum DatabaseType {
  POSTGRESQL
  MONGODB
  QDRANT
  NEO4J
}

enum DatabaseStatus {
  REQUESTED
  PENDING
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  STARTING
  RESTARTING
  ERROR
  DELETING
  DELETED
}

enum DatabaseEventType {
  CREATED
  STARTED
  STOPPED
  RESTARTED
  DELETED
  ERROR
  BACKUP_CREATED
  BACKUP_RESTORED
  CREDENTIALS_ROTATED
  CONFIGURATION_CHANGED
  SCALED
  STATUS_CHANGED
  DELETION_REQUESTED
  PROVISIONING_REQUESTED
}

enum OperationType {
  PROVISION
  START
  STOP
  RESTART
  DELETE
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  firebaseUid String       @unique @map("firebase_uid")
  email       String       @unique
  name        String?
  avatarUrl   String?      @map("avatar_url")
  role        PlatformRole @default(USER)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  ownedProjects   Project[]           @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  auditLogs       AuditLog[]
  sentInvitations ProjectInvitation[] @relation("SentInvitations")

  @@map("users")
}

enum ProjectStatus {
  REQUESTED
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  RESTARTING
  FAILED
}

model Project {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  status        ProjectStatus  @default(REQUESTED)
  vmId          String?        @map("vm_id")
  internalIp    String?        @map("internal_ip")
  cpuCores      Int            @default(2) @map("cpu_cores")
  ramMb         Int            @default(4096) @map("ram_mb")
  storageMb     Int            @default(20480) @map("storage_mb")
  failureReason String?        @map("failure_reason")
  ownerId       String         @map("owner_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  owner         User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       ProjectMember[]
  invitations   ProjectInvitation[]
  subscription  Subscription?
  databases     DatabaseInstance[]
  auditLogs     AuditLog[]
  payments      Payment[]
  subscriptionHistory SubscriptionHistory[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  role        ProjectRole      @default(MEMBER)
  token       String           @unique
  invitedById String           @map("invited_by_id") @db.Uuid
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([token])
  @@index([email])
  @@index([projectId])
  @@map("project_invitations")
}

model Plan {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  tier            SubscriptionTier
  interval        BillingInterval  @default(MONTHLY)
  amount          Int              // in paise (e.g. 0, 199900, 799900)
  currency        String           @default("INR")
  razorpayPlanId  String?          @unique @map("razorpay_plan_id")
  description     String?
  features        String[]         @default([])
  maxDatabases    Int              @map("max_databases")
  maxCpuCores     Int              @map("max_cpu_cores")
  maxRamMb        Int              @map("max_ram_mb")
  maxStorageMb    Int              @map("max_storage_mb")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  subscriptions   Subscription[]

  @@unique([tier, interval])
  @@index([tier])
  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  tier                  SubscriptionTier   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeCustomerId      String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?            @unique @map("stripe_subscription_id")
  paymentProvider       String             @default("RAZORPAY") @map("payment_provider")
  razorpaySubscriptionId String?          @unique @map("razorpay_subscription_id")
  razorpayPlanId        String?            @map("razorpay_plan_id")
  currentPeriodStart    DateTime?          @map("current_period_start")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  nextBillingDate       DateTime?          @map("next_billing_date")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime?          @map("canceled_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  projectId             String             @unique @map("project_id") @db.Uuid
  project               Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  planId                String?            @map("plan_id") @db.Uuid
  plan                  Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)

  payments              Payment[]
  history               SubscriptionHistory[]

  @@index([status])
  @@index([tier])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  projectId         String        @map("project_id") @db.Uuid
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  razorpayPaymentId String        @unique @map("razorpay_payment_id")
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpaySignature String?       @map("razorpay_signature")
  amount            Int           // Amount in paise
  currency          String        @default("INR")
  status            PaymentStatus @default(CAPTURED)
  method            String?
  errorCode         String?       @map("error_code")
  errorDescription  String?       @map("error_description")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([subscriptionId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  providerEventId String        @unique @map("provider_event_id")
  eventType       String        @map("event_type")
  payload         Json
  status          WebhookStatus @default(PENDING)
  retryCount      Int           @default(0) @map("retry_count")
  errorDetails    String?       @map("error_details")
  receivedAt      DateTime      @default(now()) @map("received_at")
  processedAt     DateTime?     @map("processed_at")

  @@index([eventType])
  @@index([status])
  @@index([receivedAt])
  @@map("webhook_events")
}

model SubscriptionHistory {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  projectId      String              @map("project_id") @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action         String
  fromTier       SubscriptionTier?   @map("from_tier")
  toTier         SubscriptionTier?   @map("to_tier")
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus? @map("to_status")
  actorId        String?             @map("actor_id")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([projectId])
  @@index([createdAt])
  @@map("subscription_history")
}

model DatabaseInstance {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  type            DatabaseType
  status          DatabaseStatus @default(REQUESTED)
  version         String?
  host            String?
  port            Int?
  cpuCores        Int            @default(1) @map("cpu_cores")
  ramMb           Int            @default(1024) @map("ram_mb")
  storageMb       Int            @default(10240) @map("storage_mb")
  internalIp      String?        @map("internal_ip")
  internalNetwork String?        @map("internal_network")
  vmId            String?        @map("vm_id")
  failureReason   String?        @map("failure_reason")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  projectId     String         @map("project_id") @db.Uuid
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  credentials   DatabaseCredential[]
  events        DatabaseEvent[]
  operations    DatabaseOperation[]

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([projectId, status])
  @@map("database_instances")
}

model DatabaseCredential {
  id              String   @id @default(uuid()) @db.Uuid
  username        String
  encryptedPassword String @map("encrypted_password")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  databaseId      String   @map("database_id") @db.Uuid
  database        DatabaseInstance @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
  @@map("database_credentials")
}

model DatabaseEvent {
  id              String            @id @default(uuid()) @db.Uuid
  type            DatabaseEventType
  message         String?
  previousStatus  DatabaseStatus?   @map("previous_status")
  newStatus       DatabaseStatus?   @map("new_status")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")

  databaseId  String            @map("database_id") @db.Uuid
  database    DatabaseInstance   @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
  @@index([createdAt])
  @@map("database_events")
}

model DatabaseOperation {
  id           String          @id @default(uuid()) @db.Uuid
  type         OperationType
  status       OperationStatus @default(PENDING)
  retryCount   Int             @default(0) @map("retry_count")
  maxRetries   Int             @default(3) @map("max_retries")
  providerOpId String?         @map("provider_op_id")
  errorDetails String?         @map("error_details")
  metadata     Json?
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  databaseId   String          @map("database_id") @db.Uuid
  database     DatabaseInstance @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("database_operations")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId   String?  @map("project_id") @db.Uuid
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
