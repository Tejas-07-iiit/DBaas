# ==============================================================================
# Multi-DBaaS Root Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 2. Secrets, Environment Variables & Credentials
# ------------------------------------------------------------------------------
# Environment files
.env
.env.*
*.env
!.env.example
!.env.template

# Cloud & Service Account keys (Firebase, AWS, GCP, etc.)
*serviceAccount*.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
*.credentials.json
credentials.json
client_secret*.json

# SSH, TLS, SSL keys & certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Generic secrets & tokens
*.secret
*.secrets
secrets/
.secrets/
token.json
tokens.json

# ------------------------------------------------------------------------------
# 3. Documents & Office Files (Spreadsheets, Word, PDF, Presentations)
# ------------------------------------------------------------------------------
# Office lock & temporary files (LibreOffice, MS Office)
.~lock.*#
.~lock*
~$*
*.tmp

# Spreadsheets & Data sheets
*.xlsx
*.xls
*.csv
*.tsv
*.ods

# Text & Word Documents
*.docx
*.doc
*.odt
*.rtf

# PDF Documents
*.pdf

# Presentations
*.pptx
*.ppt
*.odp

# Architecture & Design Documents (HTML, PNG, DrawIO)
*.html
*.png
*.drawio.png
*.drawio.bkp
*.drawio.dtmp

# Specific root documentation files
M-DBaaS_Backend_API_Endpoint.xlsx
Multi-DBaaS-Architecture.drawio.png
Multi-DBaaS-Architecture.html

# ------------------------------------------------------------------------------
# 4. Build Outputs & Compilations
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
coverage/
**/coverage/
.next/
.turbo/

# ------------------------------------------------------------------------------
# 5. Local Runtime & Database Storage Volumes
# ------------------------------------------------------------------------------
postgres-data/
redis-data/
*.rdb
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 6. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 7. IDE, Editors & Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Vim / Emacs
*.swp
*.swo
*~
.#*
