NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_POST_LOGIN_REDIRECT=/dashboard

# --- Authentication (AUTH-01..07)
NEXT_PUBLIC_AUTH_REGISTER_ENDPOINT=/auth/register
NEXT_PUBLIC_AUTH_LOGIN_ENDPOINT=/auth/login
NEXT_PUBLIC_AUTH_REFRESH_ENDPOINT=/auth/refresh
NEXT_PUBLIC_AUTH_LOGOUT_ENDPOINT=/auth/logout
NEXT_PUBLIC_AUTH_ME_ENDPOINT=/auth/me
NEXT_PUBLIC_AUTH_FORGOT_PASSWORD_ENDPOINT=/auth/forgot-password
NEXT_PUBLIC_AUTH_RESET_PASSWORD_ENDPOINT=/auth/reset-password

# --- User (USER-01..03)
NEXT_PUBLIC_USER_GET_ENDPOINT=/users/me
NEXT_PUBLIC_USER_UPDATE_ENDPOINT=/users/me
NEXT_PUBLIC_USER_DELETE_ENDPOINT=/users/me

# --- Projects (PROJ-01..05)
NEXT_PUBLIC_PROJECTS_LIST_ENDPOINT=/projects
NEXT_PUBLIC_PROJECTS_CREATE_ENDPOINT=/projects
NEXT_PUBLIC_PROJECTS_GET_ENDPOINT=/projects/:projectId
NEXT_PUBLIC_PROJECTS_UPDATE_ENDPOINT=/projects/:projectId
NEXT_PUBLIC_PROJECTS_DELETE_ENDPOINT=/projects/:projectId

# --- Team and RBAC (TEAM-01..04)
NEXT_PUBLIC_MEMBERS_LIST_ENDPOINT=/projects/:projectId/members
NEXT_PUBLIC_MEMBERS_ADD_ENDPOINT=/projects/:projectId/members
NEXT_PUBLIC_MEMBERS_UPDATE_ROLE_ENDPOINT=/projects/:projectId/members/:userId
NEXT_PUBLIC_MEMBERS_REMOVE_ENDPOINT=/projects/:projectId/members/:userId

# --- Subscription and billing (BILL-01..04)
NEXT_PUBLIC_PLANS_LIST_ENDPOINT=/plans
NEXT_PUBLIC_SUBSCRIPTION_GET_ENDPOINT=/subscription
NEXT_PUBLIC_SUBSCRIPTION_CHECKOUT_ENDPOINT=/subscription/checkout
NEXT_PUBLIC_SUBSCRIPTION_CANCEL_ENDPOINT=/subscription/cancel

# --- Databases (DB-01..10)
NEXT_PUBLIC_DATABASES_LIST_ENDPOINT=/projects/:projectId/databases
NEXT_PUBLIC_DATABASES_CREATE_ENDPOINT=/projects/:projectId/databases
NEXT_PUBLIC_DATABASES_GET_ENDPOINT=/projects/:projectId/databases/:databaseId
NEXT_PUBLIC_DATABASES_UPDATE_ENDPOINT=/projects/:projectId/databases/:databaseId
NEXT_PUBLIC_DATABASES_DELETE_ENDPOINT=/projects/:projectId/databases/:databaseId
NEXT_PUBLIC_DATABASES_START_ENDPOINT=/projects/:projectId/databases/:databaseId/start
NEXT_PUBLIC_DATABASES_STOP_ENDPOINT=/projects/:projectId/databases/:databaseId/stop
NEXT_PUBLIC_DATABASES_RESTART_ENDPOINT=/projects/:projectId/databases/:databaseId/restart
NEXT_PUBLIC_DATABASES_CONNECTION_ENDPOINT=/projects/:projectId/databases/:databaseId/connection
NEXT_PUBLIC_DATABASES_ROTATE_CREDENTIALS_ENDPOINT=/projects/:projectId/databases/:databaseId/credentials/rotate

# --- Monitoring (MON-01..03)
NEXT_PUBLIC_MONITORING_METRICS_ENDPOINT=/projects/:projectId/databases/:databaseId/metrics
NEXT_PUBLIC_MONITORING_LOGS_ENDPOINT=/projects/:projectId/databases/:databaseId/logs
NEXT_PUBLIC_MONITORING_EVENTS_ENDPOINT=/projects/:projectId/databases/:databaseId/events

# --- Admin (ADMIN-01..04)
NEXT_PUBLIC_ADMIN_USERS_ENDPOINT=/admin/users
NEXT_PUBLIC_ADMIN_PROJECTS_ENDPOINT=/admin/projects
NEXT_PUBLIC_ADMIN_DATABASES_ENDPOINT=/admin/databases
NEXT_PUBLIC_ADMIN_SYSTEM_HEALTH_ENDPOINT=/admin/system/health

# --- Demo Mode (Local Only)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@dbaas.dev
NEXT_PUBLIC_DEMO_PASSWORD=Demo@12345

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_CHECKOUT_SUCCESS_PATH=/dashboard/subscription?checkout=success
NEXT_PUBLIC_CHECKOUT_CANCEL_PATH=/dashboard/subscription?checkout=cancelled
